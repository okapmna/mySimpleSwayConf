[global]
    monitor = 0
    geometry = "300x5-30+20"
    origin = top-right
    offset = 30x50

    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = middle

    frame_width = 1
    separator_height = 2
    separator_color = frame
    corner_radius = 5

    icon_position = left
    max_icon_size = 32
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true

    sort = yes
    indicate_hidden = yes
    sticky_history = yes
    history_length = 20
    show_age_threshold = 60
    ignore_newline = no
    startup_notification = false
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/firefox -new-tab

    mouse_leave_icon = false
    mouse_move_event = do_nothing

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    highlight = "#89B4FA"

[urgency_low]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#45475A"
    timeout = 5

[urgency_normal]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#45475A"
    timeout = 10

[urgency_critical]
    background = "#1E1E2E"
    foreground = "#CDD6F4"
    frame_color = "#F38BA8"
    timeout = 0
