# =============================================
# Konfigurasi Mako - Tema Catppuccin Mocha
# Dibuat oleh Gemini
# =============================================

# -- Font & Tampilan Dasar --
# Ganti "JetBrainsMono Nerd Font" dengan font favorit Anda.
# Menggunakan Nerd Font sangat disarankan agar ikon dapat tampil.
font=pango:JetBrainsMono Nerd Font 9
max-visible=5
sort=-time

# -- Tata Letak & Jarak --
margin=5
border-radius=4
anchor=top-right
width=250
height=50
padding=2
border-size=1

# -- Skema Warna (Catppuccin Mocha) --
# Menggunakan warna dari Maroon ke bawah sesuai permintaan.
# Background: Base (#1e1e2e)
# Teks: Text (#cdd6f4)
# Border & Progress: Maroon (#eba0ac)

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #89b4fa

# -- icon --
icons=1
icon-path=/home/pmna/.icons/Tela:/usr/share/icons/Papirus-Dark:/usr/share/icons/Adwaita
# -- Format Notifikasi --
# %i = ikon
# %s = ringkasan/judul (dibuat tebal dengan <b>)
# %b = isi/body notifikasi
format=<b>%i %s</b>\n%b

# -- Perilaku (Behavior) --
default-timeout=5000
ignore-timeout=0
