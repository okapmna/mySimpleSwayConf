{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/imgart/pixelCC1.png",
        "height": 13,
        "width": 20,
        "padding": {
            "top": 0,
            "left": 3,
            "bottom": 1
        }
    },
    "modules": [
        {
            "type": "title",
            "key": " user   ",
            "padding": {
                "top": 0,
                "left": 0
            }
        },
        {
            "type": "os",
            "key": "{icon} os     ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": " kernel ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": " shell  ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " term   ",
            "keyColor": "yellow"
        },
        {
            "type": "host",
            "key": "󰌢 host   ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "󰻠 cpu    ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰍛 gpu    ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰑭 mem    ",
            "keyColor": "green"
        },
        {
            "type": "de",
            "key": " de     ",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": " wm     ",
            "keyColor": "magenta"
        },
        {
            "type": "sound",
            "key": " audio  ",
            "keyColor": "cyan"
        },
        {
            "type": "player",
            "key": "󰥠 player ",
            "keyColor": "cyan"
        },
        {
            "type": "media",
            "key": "󰝚 song   ",
            "keyColor": "cyan"
        },
        "break"
    ]
}




