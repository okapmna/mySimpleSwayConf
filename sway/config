# Sway Config - Multi-distro (Ubuntu/Fedora/Arch)

### Variables
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu dmenu_path | wmenu | xargs swaymsg exec --

include /etc/sway/config-vars.d/*

### Output configuration
output * bg ~/Pictures/wallpapers/crane.png fill

workspace 1 output eDP-1
workspace 2 output eDP-1
workspace 3 output eDP-1
workspace 4 output eDP-1
workspace 5 output eDP-1
workspace 6 output eDP-1
workspace 7 output eDP-1
workspace 8 output eDP-1
workspace 9 output HDMI-A-1
workspace 10 output HDMI-A-1

### Idle configuration
exec swayidle -w \
    timeout 900 'swaylock -f -c 000000' \
    timeout 1800 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f -c 000000'

### Input configuration
input "2:7:SynPS/2_Synaptics_TouchPad" {
    tap enabled
    tap_button_map lrm
    accel_profile adaptive
    pointer_accel 0.8
    dwt enabled
    scroll_method two_finger
    natural_scroll enable
}

input "2:10:TPPS/2_Elan_TrackPoint" {
    accel_profile flat
    pointer_accel 0.8
}

### Key bindings - Basics
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec wofi --show drun -W 500 -H 300 --prompt "Apps"
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

### Key bindings - Moving around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### Key bindings - Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

### Key bindings - Layout
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

### Key bindings - Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### Key bindings - Resize mode
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

### Status Bar
bar {
    position top
    swaybar_command waybar
    status_command while date +'%Y-%m-%d %X'; do sleep 1; done
    colors {
        statusline #ffffff
        background #323232
        inactive_workspace #32323200 #32323200 #5c5c5c
    }
}

include /etc/sway/config.d/*

### Looks
default_border pixel 3
default_floating_border none
gaps inner 5
gaps outer 2

### Catppuccin Mocha Colors
set $mocha-base       #1E1E2E
set $mocha-mantle     #181825
set $mocha-crust      #11111B
set $mocha-text       #CDD6F4
set $mocha-blue       #89B4fA
set $mocha-red        #F38BA8
set $mocha-overlay0   #6C7086

client.focused          $mocha-blue $mocha-crust $mocha-text $mocha-blue $mocha-blue
client.unfocused        $mocha-overlay0 $mocha-crust $mocha-text $mocha-overlay0 $mocha-overlay0
client.focused_inactive $mocha-overlay0 $mocha-crust $mocha-text $mocha-blue $mocha-overlay0
client.urgent           $mocha-red $mocha-crust $mocha-text $mocha-red $mocha-red
client.placeholder      $mocha-crust $mocha-crust $mocha-text $mocha-crust $mocha-crust
client.background       $mocha-crust

# Environment Variables
exec_always systemctl --user import-environment \
    WAYLAND_DISPLAY \
    SWAYSOCK \
    XDG_CURRENT_DESKTOP \
    XDG_RUNTIME_DIR \
    PIPEWIRE_RUNTIME_DIR

# XDG Desktop Portal
exec_always killall xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk xdg-desktop-portal-xapp 2>/dev/null || true
exec_always sleep 2
exec_always $HOME/.config/sway/scripts/portal-init.sh

# DBus & Polkit
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec_always $HOME/.config/sway/scripts/polkit-init.sh

# GTK Theme
set $gnome-schema org.gnome.desktop.interface
exec gsettings set $gnome-schema gtk-theme 'Orchis-Dark-Compact'
exec gsettings set $gnome-schema icon-theme 'Tela-dark'

# Live Wallpaper
bindsym $mod+Shift+w exec ~/.config/sway/scripts/livewall-selector.sh

# Screenshot - Flameshot
bindsym $mod+Print exec flameshot full --backend grim -p ~/Pictures/screenshots
bindsym $mod+Shift+Print exec flameshot gui --backend grim

# Screenshot - Grim + Slurp
bindsym $mod+Ctrl+Print exec grim - | wl-copy --type image/png && notify-send "Full screenshot copied"

bindsym $mod+Ctrl+Shift+Print exec grim -g "$(slurp)" - | swappy -f -

bindsym $mod+Alt+Print exec grim -g "$(slurp)" - | wl-copy --type image/png && notify-send "Area screenshot copied"

# Clipboard Manager (cliphist)
exec_always killall wl-paste 2>/dev/null || true
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

# View clipboard history
bindsym $mod+Shift+v exec cliphist list | wofi --dmenu --width 600 --height 400 --cache-file /dev/null | cliphist decode | wl-copy

# System

## Power menu
bindsym $mod+p exec ~/.config/wofi/power-menu.sh

## Brightness Control
bindsym XF86MonBrightnessUp exec ~/.config/sway/scripts/brightness.sh up
bindsym XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness.sh down

## Audio Control
bindsym XF86AudioRaiseVolume exec ~/.config/sway/scripts/volume.sh up
bindsym XF86AudioLowerVolume exec ~/.config/sway/scripts/volume.sh down
bindsym XF86AudioMute exec ~/.config/sway/scripts/volume.sh mute
bindsym XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
